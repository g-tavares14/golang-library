# Copie para .env e ajuste os valores locais: cp .env.example .env
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=golang

# Chave que assina os tokens JWT (mínimo de 32 caracteres). Gere uma com: openssl rand -base64 48
JWT_SECRET=change-me-with-at-least-32-characters
