# Copie para .env e ajuste os valores locais: cp .env.example .env
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=golang

# Chave que assina os tokens JWT (mínimo de 32 caracteres). Gere uma com: openssl rand -base64 48
JWT_SECRET=change-me-with-at-least-32-characters

# Admin inicial, criado na subida do servidor se o e-mail ainda não existir.
# Deixe ADMIN_EMAIL vazio para não criar. A senha só vale na primeira criação.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too
